{
  "name": "@palomapf-dev/pf-field-core",
  "version": "0.0.1",
  "description": "現場系アプリ（pf-setsubi / pf-hinshitsu / pf-zaiko / pf-keisoku）共通のオフライン・アップロード基盤",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PalomaPF-dev/pf-field-core.git",
    "directory": "packages/field-core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "pf-field-sw": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "default": "./dist/scanner.js"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "default": "./dist/sw.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsup && node scripts/verify-build.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit --pretty"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
